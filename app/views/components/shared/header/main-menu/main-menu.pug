- 
  let links = [
    {
      id: 'hp',
      name: __('views.home'),
      url: '/'
    },
    {
      id: 'transactions',
      name: __('views.transactions'),
      url: '/transactions'
    },
    {
      id: 'analysis',
      name: __('views.analysis'),
      url: '/analysis'
    },
    {
      id: 'contacts',
      name: __('views.contacts'),
      url: '/contacts'
    }
  ] 
span(class="hamburger icon-menu") 
nav(id="main-menu")
  div
    span(class="close icon-close")
    ul
      each link in links
        li(class = (id === link.id) ? "active" : "")
          if link.class
            span(class=link.class)
          a(href='/'+locale + link.url, title=link.name) #{link.name}
  