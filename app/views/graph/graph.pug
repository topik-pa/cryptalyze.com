extends ../layout.pug

block append meta
  meta(property="og:title" content=__('views.analysis') + ' | ' + __('proj_name'))
  meta(property="og:description" content=__('analysis.meta.description'))
  meta(property="og:image" content=og_image)
  meta(property="og:url" content=canonicalUrl)

  title= __('views.analysis') + ' | ' + proj_name
  meta(name="description" content=__('analysis.meta.description'))
  meta(name="keywords" content=__('analysis.meta.keywords'))

  script(src='/scripts/vendors/gitgraph.edited.js')

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  include ../components/shared/breadcrumbs/breadcrumbs.pug

  h1= __('graph.title')

  div(id="graphs-wrapper")

block column 
  include ../components/shared/column/column.pug
