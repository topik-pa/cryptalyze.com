//- Home Page Template
//- 
//- This template extends the base layout and defines the home page structure.
//- 
//- Blocks:
//-   - meta: Appends Open Graph tags, SEO meta tags, canonical URL, and hreflang links
//-   - main: Contains the main heading for the home page
//- 
//- Variables expected:
//-   - og_image: URL to the Open Graph image
//-   - canonicalUrl: Canonical URL for the page
//-   - hreflangs: Array of objects containing language alternatives (lang, url)
//- 
//- i18n keys used:
//-   - proj_tagline: Project tagline/slogan
//-   - proj_name: Project name
//-   - proj_description: Project description
//-   - index.meta.keywords: SEO keywords for the home page
//-   - home.title: Main heading text for the home page

extends ../layout.pug

block append meta
  meta(property="og:title" content=__('proj_tagline') + ' | ' + __('proj_name') )
  meta(property="og:description" content=__('proj_description'))
  meta(property="og:image" content=og_image)
  meta(property="og:url" content=canonicalUrl)

  title= __('proj_tagline') + ' | ' + __('proj_name')
  meta(name="description" content=__('proj_description'))
  meta(name="keywords" content=__('index.meta.keywords'))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  section 
    h2= __('home.upload-csv.title')
    p!= __('home.upload-csv.text')
    form(id="transactions-upload" action='/transactions', method='POST', enctype='multipart/form-data')
      input(id="transactions-input" type='file', name='file', accept='.xlsx, .xls, .csv', required='true' hidden)

      div#drop Drag the file here or click to select it
      p#file-name

      button(id="upload-transactions", type='submit', class="btn primary disabled") Upload file
  section 
    h2= __('home.loaded-csv.title')
    p= __('home.loaded-csv.text')
