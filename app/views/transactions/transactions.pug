extends ../layout.pug

block append meta
  meta(property="og:title" content=__('views.transactions') + ' | ' + __('proj_name'))
  meta(property="og:description" content=__('transactions.meta.description'))
  meta(property="og:image" content=og_image)
  meta(property="og:url" content=canonicalUrl)

  title= __('views.transactions') + ' | ' + proj_name
  meta(name="description" content=__('transactions.meta.description'))
  meta(name="keywords" content=__('transactions.meta.keywords'))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

  script(src='/scripts/vendors/datatables.min.js')
  link(rel='stylesheet', href='/styles/vendors/datatables.min.css')

block main
  if data
    input(type="hidden", id="transactions-data", data-transactions=JSON.stringify(data))
  include ../components/shared/breadcrumbs/breadcrumbs.pug

  h1= __('transactions.title')

  div#transactions-table-container

block column 
  include ../components/shared/column/column.pug
