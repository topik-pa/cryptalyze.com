extends ../layout.pug

block append meta
  title #{title} | #{proj_name}
  meta(name="description" content="")
  meta(name="keywords" content="")
  meta(name="robots" content="")
  link(rel="canonical", href=proj_url + url)

  link(href='https://cdn.datatables.net/v/dt/jq-3.7.0/dt-2.3.5/datatables.min.css', rel='stylesheet', integrity='sha384-lw6xqXSsLbv9Bk8p8sb0Eoqxc5YTKvHwiXBG3EDVIqCaj4r4rCCnDDHY4As+neWR', crossorigin='anonymous')
  script(src='https://cdn.datatables.net/v/dt/jq-3.7.0/dt-2.3.5/datatables.min.js', integrity='sha384-GnTdsJpz17/btlSP5bFmeEv1QtW4NUnE9Atd4eMZjHBvJvYTrQTmTzLAKL2wlBEt', crossorigin='anonymous')
  script(src='/scripts/vendors/gitgraph.edited.js')
  script. 
    const data = !{JSON.stringify(transactions)};

  meta(name="og:url" content="")
  meta(name="og:type" content="")
  meta(name="og:title" content="")
  meta(name="og:site_name" content="")
  meta(name="og:description" content="")
  meta(name="og:image" content="")

block main
  h1 Transaction history
  
  section
    h2 Dynamic table
    table(border="1", cellpadding="6", id="table", class="table table-striped")
      thead
        tr
          th Date(UTC)
          th Order No.
          th Pair
          th Base Asset
          th Quote Asset
          th Type
          th Order Price
          th Order Amount
          th Filled
          th Total
          th Status
      tbody
        each item in transactions
          tr
            td= item.date
            td= item.orderNo
            td= item.pair
            td= item.baseAsset
            td= item.quoteAsset
            td= item.type
            td= item.orderPrice
            td= item.orderAmount
            td= item.filled
            td= item.total
            td= item.status
    button(onclick='window.print()', style='margin-bottom: 20px; padding: 10px 20px;') Print data

  section(id="graph")
    h2 Git-like graph
    div(id="gitgraph")
