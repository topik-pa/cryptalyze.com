extends layout.pug

block append meta
  title #{proj_name}
  meta(name="description" content="")
  meta(name="keywords" content="")
  meta(name="robots" content="")
  link(rel="canonical", href=proj_url)

  meta(name="og:url" content="")
  meta(name="og:type" content="")
  meta(name="og:title" content="")
  meta(name="og:site_name" content="")
  meta(name="og:description" content="")
  meta(name="og:image" content="")

block main
  h1 Carica il file Excel delle transazioni
  form(action='/transactions', method='POST', enctype='multipart/form-data')
    input(type='file', name='file', accept='.xlsx, .xls, .csv', required='true')
    button(type='submit') Carica

