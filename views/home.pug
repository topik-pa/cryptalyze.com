extends layout.pug

block append meta
  title #{proj_name}
  meta(name="description" content="")
  meta(name="keywords" content="")
  meta(name="robots" content="")
  link(rel="canonical", href=proj_url)

  meta(name="og:url" content="")
  meta(name="og:type" content="")
  meta(name="og:title" content="")
  meta(name="og:site_name" content="")
  meta(name="og:description" content="")
  meta(name="og:image" content="")

block main
  h1 Upload your transaction history... so we can clarify it for you
  p Currently, we can analyse #[em Benance] and #[em Bybit] file format only.
  form(action='/transactions', method='POST', enctype='multipart/form-data')
    input(id="fileInput" type='file', name='file', accept='.xlsx, .xls, .csv', required='true' hidden)

    div#dropArea Drag the file here or click to select it
    p#fileName

    button(id="submitBtn", type='submit', class="btn primary disabled") Upload file
    

